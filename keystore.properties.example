# Copia este archivo como keystore.properties (no se sube a git) y rellena los datos de tu clave.
# Crea la clave en Android Studio: Build › Generate Signed App Bundle / APK › APK › Create new…
# Guarda el .jks en la raíz del repositorio y haz copia de seguridad: sin ella no podrás actualizar TV-Os sin desinstalar.
# Usa contraseñas sin tildes ni ñ (Gradle lee este archivo en ISO-8859-1).
storeFile=tvos-release.jks
storePassword=tu_contrasena
keyAlias=tvos
keyPassword=tu_contrasena
